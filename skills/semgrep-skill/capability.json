{
  "schemaVersion": 1,
  "id": "semgrep-skill",
  "componentType": "skill",
  "componentVersion": "1.1.0",
  "entrypoint": "SKILL.md",
  "capabilities": [
    {
      "id": "local-security-scan",
      "summary": "Run the installed local Semgrep CLI on an explicitly authorized local directory with two bundled non-secret rules and a sanitized JSON result; no remote configuration or source changes.",
      "useWhen": [
        "An explicitly authorized directory needs a read-only baseline for Python shell=True or JavaScript/TypeScript eval patterns.",
        "The caller accepts bounded coverage and distinguishes findings from completion."
      ],
      "doNotUseWhen": [
        "Remote Semgrep Registry rules, Semgrep Cloud, login, upload, or network access are required.",
        "The requested outcome includes automatic remediation or source-file writes.",
        "Semgrep is not already installed and executable.",
        "Credential-pattern scanning or returning source excerpts is required.",
        "The target contains links, more than 512 eligible files, or eligible files over 1 MiB."
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "workspaceRoot",
          "target"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "workspaceRoot": {
            "type": "string",
            "description": "Explicit absolute authorized local directory; no drive root, network paths or links."
          },
          "target": {
            "type": "string",
            "description": "Existing directory contained by workspaceRoot; no implicit current-directory target."
          },
          "rules": {
            "const": "rules/local-security.yml"
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "componentVersion",
          "status",
          "completed",
          "findings",
          "errors",
          "runtime",
          "rules",
          "networkUsed",
          "filesModified"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "componentVersion": {
            "const": "1.1.0"
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "invalid_input",
              "unavailable",
              "failed"
            ]
          },
          "completed": {
            "type": "boolean"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "checkId",
                "path",
                "start",
                "end",
                "severity",
                "message"
              ],
              "properties": {
                "checkId": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "start": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "line",
                    "col"
                  ],
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "col": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "end": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "line",
                    "col"
                  ],
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "col": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "severity": {
                  "enum": [
                    "INFO",
                    "WARNING",
                    "ERROR"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pythonVersion",
              "semgrepVersion"
            ],
            "properties": {
              "pythonVersion": {
                "type": "string"
              },
              "semgrepVersion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "rules": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "sourceSha256",
              "effectiveSha256",
              "includedRuleIds"
            ],
            "properties": {
              "source": {
                "const": "canonical:skills/semgrep-skill/rules/local-security.yml"
              },
              "sourceSha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effectiveSha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "includedRuleIds": {
                "const": [
                  "python-subprocess-shell-true",
                  "javascript-eval"
                ]
              }
            }
          },
          "networkUsed": {
            "const": false
          },
          "filesModified": {
            "const": false
          }
        }
      },
      "permissions": [
        "Read the selected local scan target.",
        "Execute an already-installed local Semgrep binary."
      ],
      "sideEffects": [],
      "humanGate": {
        "required": false,
        "when": []
      },
      "validation": [
        "tests/test_behavior.py",
        "tests/test_scan.py"
      ],
      "invocation": {
        "schemaVersion": 1,
        "type": "local_cli",
        "runtime": "python",
        "entrypoint": "scripts/scan.py",
        "argv": [
          "--input-json",
          "-"
        ],
        "inputTransport": "stdin_json",
        "outputTransport": "stdout_json",
        "shell": false
      }
    },
    {
      "id": "preview-skill-projection-change",
      "summary": "Preview an installation, upgrade, or rollback of the Skill projection at an explicitly selected project or user scope without writing files.",
      "useWhen": [
        "The caller wants to inspect the exact target and action before authorizing an installation or rollback."
      ],
      "doNotUseWhen": [
        "The target contains unknown, modified, linked, or unreceipted content.",
        "The caller expects the preview to write files, install Semgrep, download rules, or overwrite the legacy code-security directory."
      ],
      "input": {
        "type": "object",
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "projectRoot": {
            "type": "string"
          },
          "rollback": {
            "type": "boolean"
          },
          "apply": {
            "const": false
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "ok",
          "action",
          "mode",
          "target"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "enum": [
              "install",
              "rollback"
            ]
          },
          "mode": {
            "const": "dry-run"
          },
          "target": {
            "type": "string"
          }
        }
      },
      "permissions": [
        "Read the component source and the selected installation target."
      ],
      "sideEffects": [],
      "humanGate": {
        "required": false,
        "when": []
      },
      "validation": [
        "tests/test_installer.py"
      ]
    },
    {
      "id": "apply-skill-installation",
      "summary": "Install or upgrade the Skill projection at an explicitly selected project or user scope after approval; this does not install Semgrep.",
      "useWhen": [
        "The caller approved applying a previously previewed project-scoped or user-scoped semgrep-skill installation."
      ],
      "doNotUseWhen": [
        "The target contains unknown, modified, linked, or unreceipted content.",
        "The caller has not approved the write or expects Semgrep, remote rules, or the legacy code-security directory to be changed."
      ],
      "input": {
        "type": "object",
        "required": [
          "scope",
          "apply"
        ],
        "properties": {
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "projectRoot": {
            "type": "string"
          },
          "apply": {
            "const": true
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "ok",
          "action",
          "mode",
          "target",
          "targetHash"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "const": "install"
          },
          "mode": {
            "const": "apply"
          },
          "target": {
            "type": "string"
          },
          "targetHash": {
            "type": "string"
          }
        }
      },
      "permissions": [
        "Read the component source and selected installation target.",
        "Write only the selected semgrep-skill target and installer-owned backup directory."
      ],
      "sideEffects": [
        "Creates or replaces the selected Skill projection and writes a receipt.",
        "On upgrade, retains the verified previous installation for rollback."
      ],
      "humanGate": {
        "required": true,
        "when": [
          "Before passing --apply for a project installation or upgrade.",
          "Before passing --apply at user scope, which affects all projects for that user."
        ]
      },
      "validation": [
        "tests/test_installer.py"
      ]
    },
    {
      "id": "apply-skill-rollback",
      "summary": "Restore the receipted previous Skill projection after explicit approval while preserving the displaced current version.",
      "useWhen": [
        "A validated previous installation exists and the caller approved restoring it."
      ],
      "doNotUseWhen": [
        "The current or previous installation is missing, modified, linked, unknown, or unreceipted.",
        "The caller has not approved replacing the current projection."
      ],
      "input": {
        "type": "object",
        "required": [
          "scope",
          "apply",
          "rollback"
        ],
        "properties": {
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "projectRoot": {
            "type": "string"
          },
          "apply": {
            "const": true
          },
          "rollback": {
            "const": true
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "ok",
          "action",
          "mode",
          "target",
          "targetHash"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "action": {
            "const": "rollback"
          },
          "mode": {
            "const": "apply"
          },
          "target": {
            "type": "string"
          },
          "targetHash": {
            "type": "string"
          }
        }
      },
      "permissions": [
        "Read the current and receipted previous installation.",
        "Replace only the selected semgrep-skill target and installer-owned backup entries."
      ],
      "sideEffects": [
        "Restores the previous projection and retains the displaced current projection as a backup."
      ],
      "humanGate": {
        "required": true,
        "when": [
          "Before passing --rollback with --apply at project or user scope."
        ]
      },
      "validation": [
        "tests/test_installer.py"
      ]
    }
  ]
}
