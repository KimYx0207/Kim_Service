                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "type": {
