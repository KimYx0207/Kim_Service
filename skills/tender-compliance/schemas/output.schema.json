{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from capability.json output; edit the contract and rebuild.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "使用当前机器回执版本1，不接受不同语义的包。"
    },
    "protocol": {
      "const": "kim-service-helper-v1",
      "description": "协议为kim-service-helper-v1，输出为一条完整JSON回执。"
    },
    "capabilityId": {
      "const": "tender-compliance-deliver",
      "description": "必须对应本次选定能力tender-compliance-deliver。"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "organizationId",
        "workId",
        "revision"
      ],
      "description": "原样保留本次organizationId、workId和revision。"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "用runtime canonical函数对实际完整输入重算SHA256。"
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "用同一规则对本次policy.json重算SHA256。"
    },
    "status": {
      "enum": [
        "completed",
        "needs_review"
      ],
      "description": "强制条款有缺口、截止已到、未知响应条款或任一响应未完成时needs_review；即使completed，readiness也只到ready_for_content_review，legalCompliance仍为not_determined。"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deadlinePassed": {
          "type": "boolean"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "mandatory": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "documented_pending_content_review",
                  "needs_review",
                  "noncompliant"
                ]
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 0,
                "maxItems": 50
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0,
                "maxItems": 30
              }
            },
            "required": [
              "id",
              "mandatory",
              "status",
              "issues",
              "evidenceIds"
            ]
          },
          "minItems": 1,
          "maxItems": 500
        },
        "blockingClauseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 500
        },
        "unknownResponseClauses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 500
        },
        "readiness": {
          "enum": [
            "evidence_gaps",
            "ready_for_content_review"
          ]
        },
        "legalCompliance": {
          "const": "not_determined"
        },
        "evidenceAuthentication": {
          "const": "supplied_references_not_verified"
        }
      },
      "required": [
        "tenderId",
        "deadlinePassed",
        "rows",
        "blockingClauseIds",
        "unknownResponseClauses",
        "readiness",
        "legalCompliance",
        "evidenceAuthentication"
      ],
      "description": "每个条款保留原文定位与当前版本，响应逐一对应；版本落后、缺响应、缺引用、过期证据和明确不符合必须分开报告；强制项不能被其他得分抵消。"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelCalled": {
          "const": false
        },
        "networkAccessed": {
          "const": false
        },
        "businessStatePersisted": {
          "const": false
        },
        "finalAcceptance": {
          "const": "not_decided"
        }
      },
      "required": [
        "modelCalled",
        "networkAccessed",
        "businessStatePersisted",
        "finalAcceptance"
      ],
      "description": "只声明本次离线运算，模型、网络、业务持久化均false，最终接受not_decided。"
    }
  },
  "required": [
    "schemaVersion",
    "protocol",
    "capabilityId",
    "context",
    "inputSha256",
    "policySha256",
    "status",
    "result",
    "claims"
  ]
}
