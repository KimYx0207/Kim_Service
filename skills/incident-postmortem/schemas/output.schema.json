{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from capability.json output; edit the contract and rebuild.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "使用当前机器回执版本1，不接受不同语义的包。"
    },
    "protocol": {
      "const": "kim-service-helper-v1",
      "description": "协议为kim-service-helper-v1，输出为一条完整JSON回执。"
    },
    "capabilityId": {
      "const": "incident-postmortem-deliver",
      "description": "必须对应本次选定能力incident-postmortem-deliver。"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "organizationId",
        "workId",
        "revision"
      ],
      "description": "原样保留本次organizationId、workId和revision。"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "用runtime canonical函数对实际完整输入重算SHA256。"
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "用同一规则对本次policy.json重算SHA256。"
    },
    "status": {
      "enum": [
        "completed",
        "needs_review"
      ],
      "description": "缺行动类型、负责人/期限/验证条件、逾期未完成或声称完成却无证据时needs_review；completed只表示给定记录检查完成且没有这些缺口。"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incidentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "durationsMinutes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detection": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "detectionToMitigation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "mitigationToRecovery": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "customerImpact": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000,
              "description": "仅当startedAt/recoveredAt分别为实际客户影响起止时成立；单事故时长，不是平均MTTR。"
            }
          },
          "required": [
            "detection",
            "detectionToMitigation",
            "mitigationToRecovery",
            "customerImpact"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "issues": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 0,
                "maxItems": 8
              },
              "overdue": {
                "type": "boolean"
              },
              "evidenceSupportedCompletion": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "issues",
              "overdue",
              "evidenceSupportedCompletion"
            ]
          },
          "minItems": 0,
          "maxItems": 100
        },
        "missingActionTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 3
        },
        "metricScope": {
          "const": "single_incident_not_mean_mttr"
        },
        "causeAssessment": {
          "const": "requires_source_based_review"
        }
      },
      "required": [
        "incidentId",
        "durationsMinutes",
        "actions",
        "missingActionTypes",
        "metricScope",
        "causeAssessment"
      ],
      "description": "时间按显式时区比较且开始≤发现≤缓解≤恢复≤观察时点；客户影响时长与分段相加一致。每项完成状态需要证据引用，缺失类型与逾期不能被平均分抵消。"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelCalled": {
          "const": false
        },
        "networkAccessed": {
          "const": false
        },
        "businessStatePersisted": {
          "const": false
        },
        "finalAcceptance": {
          "const": "not_decided"
        }
      },
      "required": [
        "modelCalled",
        "networkAccessed",
        "businessStatePersisted",
        "finalAcceptance"
      ],
      "description": "只声明本次离线运算，模型、网络、业务持久化均false，最终接受not_decided。"
    }
  },
  "required": [
    "schemaVersion",
    "protocol",
    "capabilityId",
    "context",
    "inputSha256",
    "policySha256",
    "status",
    "result",
    "claims"
  ]
}
