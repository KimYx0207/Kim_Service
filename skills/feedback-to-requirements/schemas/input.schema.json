{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from capability.json input; edit the contract and rebuild.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "organizationId",
        "workId",
        "revision"
      ]
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "customerId": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "duplicateOf": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "projectId",
          "customerId",
          "text",
          "sourceRef"
        ]
      },
      "minItems": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "recordIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "recordIds",
          "acceptanceCriteria"
        ]
      },
      "minItems": 0
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "roles"
        ]
      },
      "minItems": 1
    },
    "adoptionRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "candidateSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "actorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "adopted",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "candidateId",
          "candidateSha256",
          "actorId",
          "status",
          "reason",
          "evidenceRef"
        ]
      },
      "minItems": 0
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "recordIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 2
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "recordIds",
          "reason"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "context",
    "projectId",
    "records",
    "groups",
    "members",
    "adoptionRole"
  ]
}
