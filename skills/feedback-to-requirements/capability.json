{
  "schemaVersion": 1,
  "id": "feedback-to-requirements",
  "componentType": "skill",
  "componentVersion": "0.1.0",
  "entrypoint": "SKILL.md",
  "capabilities": [
    {
      "id": "feedback-to-requirements-deliver",
      "summary": "将客户反馈、明确重复关系与分组转成需求候选，计算独立客户数，保留矛盾证据和版本绑定采纳记录。 feedback requirements evidence ledger",
      "useWhen": [
        "反馈转需求证据台账",
        "接收同一公司 Work/项目内的原始反馈及来源，保留客户 ID 或匿名状态。",
        "生成带证据哈希的需求候选、客户去重计数、未分类和矛盾清单。"
      ],
      "doNotUseWhen": [
        "不复制 AGPL 源码，不接管产品库，不自动判定语义重复，不用点赞数冒充独立客户数。",
        "需要新增账号权限或未经授权的外部数据读取。",
        "需要把离线投影当作业务系统真实写入或最终验收。"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "organizationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "workId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "organizationId",
              "workId",
              "revision"
            ]
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "projectId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "customerId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50000
                },
                "sourceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "duplicateOf": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "projectId",
                "customerId",
                "text",
                "sourceRef"
              ]
            },
            "minItems": 1
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "recordIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "minItems": 1
                },
                "acceptanceCriteria": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "title",
                "recordIds",
                "acceptanceCriteria"
              ]
            },
            "minItems": 0
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "roles"
              ]
            },
            "minItems": 1
          },
          "adoptionRole": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "candidateId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "candidateSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "actorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "status": {
                  "enum": [
                    "adopted",
                    "rejected"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "evidenceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "candidateId",
                "candidateSha256",
                "actorId",
                "status",
                "reason",
                "evidenceRef"
              ]
            },
            "minItems": 0
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "recordIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "minItems": 2
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "recordIds",
                "reason"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "context",
          "projectId",
          "records",
          "groups",
          "members",
          "adoptionRole"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "protocol": {
            "const": "kim-service-helper-v1"
          },
          "capabilityId": {
            "const": "feedback-to-requirements-deliver"
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "organizationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "workId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "organizationId",
              "workId",
              "revision"
            ]
          },
          "inputSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "policySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "completed",
              "needs_review"
            ]
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "projectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "feedbackSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "lineage": {
                "type": "array"
              },
              "candidates": {
                "type": "array"
              },
              "contradictions": {
                "type": "array"
              },
              "unclassifiedRecordIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "minItems": 0
              },
              "counts": {
                "type": "object"
              },
              "interpretation": {
                "type": "object"
              }
            },
            "required": [
              "projectId",
              "feedbackSha256",
              "lineage",
              "candidates",
              "contradictions",
              "unclassifiedRecordIds",
              "counts",
              "interpretation"
            ]
          },
          "claims": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "modelCalled": {
                "const": false
              },
              "networkAccessed": {
                "const": false
              },
              "businessStatePersisted": {
                "const": false
              },
              "finalAcceptance": {
                "const": "not_decided"
              }
            },
            "required": [
              "modelCalled",
              "networkAccessed",
              "businessStatePersisted",
              "finalAcceptance"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "protocol",
          "capabilityId",
          "context",
          "inputSha256",
          "policySha256",
          "status",
          "result",
          "claims"
        ]
      },
      "permissions": [],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "业务取舍、采纳及新增外部动作沿用当前宿主授权；已有决定不重复询问，纯本地核验可继续。"
        ]
      },
      "helperContract": "helper-contract.json",
      "validation": [
        "tests/helper.test.mjs"
      ]
    }
  ]
}
