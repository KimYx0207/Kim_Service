        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "organizationId",
        "workId",
        "revision"
      ]
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "completed",
        "needs_review"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "index": {
          "type": "object"
        },
        "context": {
          "type": "object"
        },
        "extraction": {
          "type": "object"
        },
        "handoff": {
          "type": "object"
        },
        "coreInputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packRef": {
          "type": "object",
