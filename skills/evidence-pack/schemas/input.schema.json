{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from capability.json input; edit the contract and rebuild.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "organizationId",
        "workId",
        "revision"
      ]
    },
    "operation": {
      "enum": [
        "build",
        "read"
      ]
    },
    "chunkBytes": {
      "type": "integer",
      "minimum": 1
    },
    "indexOffset": {
      "type": "integer",
      "minimum": 0
    },
    "indexPageSize": {
      "type": "integer",
      "minimum": 1
    },
    "contextBudgetBytes": {
      "type": "integer",
      "minimum": 1
    },
    "chunkIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      },
      "minItems": 0
    },
    "selectionOffset": {
      "type": "integer",
      "minimum": 0
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "packPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "startByte": {
                  "type": "integer",
                  "minimum": 0
                },
                "endByte": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "startByte",
                "endByte"
              ]
            },
            "minItems": 0
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id",
          "title",
          "revision",
          "path"
        ]
      }
    },
    "expectedPackSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifySourceFiles": {
      "type": "boolean"
    }
  },
  "required": [
    "context",
    "operation",
    "workspaceRoot",
    "packPath"
  ]
}
