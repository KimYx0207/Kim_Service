{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from capability.json input; edit the contract and rebuild.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "organizationId",
        "workId",
        "revision"
      ]
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              }
            },
            "required": [
              "id",
              "title",
              "explanation"
            ]
          },
          "minItems": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "stageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "input",
                  "action",
                  "decision",
                  "result"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "stageId",
              "kind"
            ]
          },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "kind": {
                "enum": [
                  "flow",
                  "return",
                  "decision"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 0,
                "maxLength": 30
              }
            },
            "required": [
              "id",
              "from",
              "to",
              "kind"
            ]
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "label",
              "ref"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "title",
        "stages",
        "nodes",
        "edges"
      ]
    },
    "locale": {
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "panel": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "panelAlt": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "card": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "line": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "return": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "decision": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": []
    }
  },
  "required": [
    "context",
    "diagram"
  ]
}
