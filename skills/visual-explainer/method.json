{
  "schemaVersion": 1,
  "roleId": "visual-explainer",
  "protocol": "host-bound-task-method-v1",
  "runtimeStatus": "needs_probe",
  "automaticInvocation": false,
  "coordinationOwner": "caller",
  "finalAcceptance": "caller_only",
  "permissionSource": "current_task_host_authorization",
  "steps": [
    "从真实系统说明提取阶段、节点、分支、返回路径与来源，人工判断内容是否准确。",
    "执行图数据校验，拆开超过五个并排节点的阶段。",
    "生成 SVG、storyboard.html 和文字替代文本；首尾沿共同中轴布局。",
    "逐阶段检查解释和关联，宿主有浏览器时再做实际渲染检查。"
  ],
  "acceptance": [
    "按阶段逐步显现，保留静态全图、键盘操作和减少动态效果的选择。",
    "核对本次输出哈希、未完成项及宿主采纳边界。"
  ],
  "knowledgeAssets": [
    {
      "id": "visual-explainer-method",
      "path": "references/method.md",
      "appliesTo": [
        "always"
      ],
      "sourceRefs": [
        "slidev"
      ]
    }
  ],
  "expertise": {
    "schemaVersion": 1,
    "domain": "分阶段图解",
    "scope": [
      "按阶段逐步显现，保留静态全图、键盘操作和减少动态效果的选择。",
      "不复制实现，不用图生绘制精确架构，不声称动画代表真实执行；本版只支持有界分层布局。"
    ],
    "knowledgeAssetIds": [
      "visual-explainer-method"
    ],
    "diagnosticSequence": [
      {
        "id": "scope",
        "question": "当前材料属于哪个组织、事项和版本？",
        "evidenceRequired": [
          "context",
          "输入材料"
        ],
        "whenMissing": "补齐身份范围后进行关联计算，其他独立解释可继续。"
      },
      {
        "id": "evidence",
        "question": "当前结果是否有原始材料和可复算依据？",
        "evidenceRequired": [
          "运行 JSON",
          "输出哈希"
        ],
        "whenMissing": "保留未知和未完成项，不生成完成记录。"
      }
    ],
    "decisionRules": [
      {
        "id": "dangling-edge",
        "when": "边引用不存在的节点",
        "action": "拒绝图数据",
        "avoid": "画出看似完整的假连接"
      },
      {
        "id": "motion-truth",
        "when": "动画显示推进",
        "action": "标注仅为说明图",
        "avoid": "声称业务已经运行完成"
      }
    ],
    "contractGuidance": [
      {
        "capabilityId": "visual-explainer-deliver",
        "inputGuidance": [
          {
            "field": "context",
            "interpretation": "context 详见 schemas/input.schema.json。",
            "onMissing": "缺失必填结构时修正输入；不要猜造真实数据。"
          },
          {
            "field": "diagram",
            "interpretation": "diagram 详见 schemas/input.schema.json。",
            "onMissing": "缺失必填结构时修正输入；不要猜造真实数据。"
          }
        ],
        "outputChecks": [
          {
            "id": "visual-explainer-schemaversion",
            "field": "schemaVersion",
            "criterion": "结果必须满足包内可执行 schema、输入哈希及当前公司事项版本。",
            "rejectWhen": "该字段缺失、伪造或不匹配当前运行。",
            "verificationMethod": "deterministic_recompute",
            "evidenceRequired": [
              "examples/input.json",
              "schemas/output.schema.json"
            ],
            "blocking": true
          },
          {
