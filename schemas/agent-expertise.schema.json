{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KimYx0207/Kim_Service/schemas/agent-expertise.schema.json",
  "title": "Optional professional knowledge assembly contract",
  "description": "Describes authored professional methods and cases. Neither schema validity nor case expectations certify expert judgment, authorize tools, or accept delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "scope",
    "knowledgeAssetIds",
    "diagnosticSequence",
    "decisionRules",
    "contractGuidance",
    "reviewBoundary",
    "evaluation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "domain": {
      "$ref": "#/$defs/text"
    },
    "scope": {
      "$ref": "#/$defs/textList"
    },
    "knowledgeAssetIds": {
      "$ref": "#/$defs/idList"
    },
    "diagnosticSequence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "evidenceRequired",
          "whenMissing"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "question": {
            "$ref": "#/$defs/text"
          },
          "evidenceRequired": {
            "$ref": "#/$defs/textList"
          },
          "whenMissing": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "decisionRules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "action",
          "avoid"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "when": {
            "$ref": "#/$defs/text"
          },
          "action": {
            "$ref": "#/$defs/text"
          },
          "avoid": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "contractGuidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "inputGuidance",
          "outputChecks"
        ],
        "properties": {
          "capabilityId": {
            "$ref": "#/$defs/id"
          },
          "inputGuidance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 48,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "interpretation",
                "onMissing"
              ],
              "properties": {
                "field": {
                  "$ref": "#/$defs/field"
                },
                "interpretation": {
                  "$ref": "#/$defs/text"
                },
                "onMissing": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "outputChecks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 48,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "criterion",
                "rejectWhen"
              ],
              "properties": {
                "field": {
                  "$ref": "#/$defs/field"
                },
                "criterion": {
                  "$ref": "#/$defs/text"
                },
                "rejectWhen": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          }
        }
      }
    },
    "reviewBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanReviewTriggers",
        "prohibitedClaims"
      ],
      "properties": {
        "humanReviewTriggers": {
          "$ref": "#/$defs/textList"
        },
        "prohibitedClaims": {
          "$ref": "#/$defs/textList"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "casesPath",
        "professionalEffect",
        "evidenceKind"
      ],
      "properties": {
        "casesPath": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.json$"
        },
        "professionalEffect": {
          "const": "not_evaluated"
        },
        "evidenceKind": {
          "const": "authored_examples"
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^\\S+$"
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    }
  }
}
