{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KimYx0207/Kim_Service/schemas/agent-expertise-cases.schema.json",
  "title": "Authored professional review cases",
  "description": "Synthetic input and partial candidate output examples for qualitative review. Expected dispositions are author hypotheses, not executed model or human results. Checks bind fields to the existing capability contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "roleId",
    "protocol",
    "inputProvenance",
    "evaluationStatus",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "roleId": {
      "$ref": "#/$defs/id"
    },
    "protocol": {
      "const": "professional-review-cases-v1"
    },
    "inputProvenance": {
      "const": "synthetic"
    },
    "evaluationStatus": {
      "const": "not_evaluated"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capabilityId",
          "category",
          "scenario",
          "input",
          "candidateOutputExcerpt",
          "expectedAssessment",
          "reason",
          "diagnosticRefs",
          "decisionRuleRefs"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "capabilityId": {
            "$ref": "#/$defs/id"
          },
          "category": {
            "enum": [
              "worked_example",
              "failure_boundary"
            ]
          },
          "scenario": {
            "$ref": "#/$defs/text"
          },
          "input": {
            "type": "object"
          },
          "candidateOutputExcerpt": {
            "type": "object",
            "minProperties": 1
          },
          "expectedAssessment": {
            "enum": [
              "acceptable_example",
              "reject_example"
            ]
          },
          "reason": {
            "$ref": "#/$defs/text"
          },
          "diagnosticRefs": {
            "$ref": "#/$defs/idList"
          },
          "decisionRuleRefs": {
            "$ref": "#/$defs/idList"
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^(?=[\\s\\S]*\\S)[\\s\\S]+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    }
  }
}
