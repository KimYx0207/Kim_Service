{
  "schemaVersion": 1,
  "id": "product-architect",
  "componentType": "agent",
  "componentVersion": "0.2.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "product-architect-deliver",
      "summary": "先探索需求和关键取舍，再形成完整产品设计，最后拆可演示的交付切片",
      "useWhen": [
        "目标还笼统，需要依据现状给出建议、替代方案和关键取舍",
        "跨前后端或多个系统，需要接口与迁移方案",
        "旧实现与新目标冲突，需要明确取舍"
      ],
      "doNotUseWhen": [
        "只要短文改稿：使用 script-writer",
        "只要界面视觉：交 interaction-designer",
        "没有授权的部署、购买和删库：交调用方决定"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "goal": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "用户目标、已定范围和非目标；未确定方向保留为待决定项"
          },
          "currentSystem": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "已知现状、来源和未知项；允许尚无软件系统，不要求编造组件"
          },
          "constraints": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "权限、时间、兼容、成本和不能变的边界"
          },
          "phase": {
            "type": "string",
            "enum": ["requirements_exploration", "complete_design", "delivery_slicing"],
            "description": "调用方当前阶段；关键选择未定不能跳到完整设计或任务拆分"
          },
          "settledDecisions": {
            "type": ["string", "object", "array"],
            "description": "调用方已有选择、依据和来源；不重复访谈，缺少关键选择交回调用方"
          },
          "runtimeBindings": {
            "type": "array",
            "description": "宿主对本次任务实际工具的绑定；需求不等于权限。未知/拒绝必须保留",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "available",
                    "missing",
                    "denied",
                    "unverified"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "authorizationRef": {
                  "type": "string"
                },
                "receiptRef": {
                  "type": "string"
                }
              },
              "required": [
                "slot",
                "state",
                "scope"
              ]
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "description": "当前阶段的角色产出标准。requirements_exploration只验建议依据、取舍和关键问题依赖，不要求已定的最终产品验收；后续阶段采用已定产品标准。",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "evidenceRequired": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "condition",
                "evidenceRequired"
              ]
            }
          },
          "handoffContext": {
            "type": "object",
            "description": "只给本角色相关材料与依赖产物；控制权保留调用方",
            "properties": {
              "taskId": {
                "type": "string"
              },
              "upstreamArtifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "permittedActions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resourceLeases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "string"
                    },
                    "ownerTaskId": {
                      "type": "string"
                    },
                    "leaseRef": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "resource",
                    "ownerTaskId",
                    "leaseRef"
                  ]
                }
              }
            },
            "required": [
              "taskId",
              "upstreamArtifacts",
              "permittedActions",
              "resourceLeases"
            ]
          }
        },
        "required": [
          "goal",
          "currentSystem",
          "constraints",
          "acceptanceCriteria",
          "handoffContext"
        ]
      },
      "output": {
        "type": "object",
        "deliveryFormat": "conceptual-human-delivery",
        "description": "以下字段可用清晰正文交付；机器回执须另经helper验证。completed只限列明角色产物，不是最终用户结果或上线许可。",
        "properties": {
          "scope": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "范围、非目标和最小可演示切片"
          },
          "architecture": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "组件责任、接口、状态转移、失败恢复与决策依据"
          },
          "migration": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "兼容、分批迁移、回滚与验收标准"
          },
          "exploration": {
            "type": ["string", "object", "array"],
            "description": "事实与假设、领域术语冲突、待决定项的id/依赖/选项/推荐/取舍/依据，以及回答后更新的当前问题"
          },
          "experienceDesign": {
            "type": ["string", "object", "array"],
            "description": "关键选择明确后的完整用户动机、操作反馈、规则、资源、结果与失败恢复；未知保留影响、责任和验证方法"
          },
          "deliverySlices": {
            "type": ["string", "object", "array"],
            "description": "完整设计确定后的可演示用户结果切片；每项有输入版本、产物、真实阻塞依赖和演示验收，不是岗位清单"
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "needs_input",
              "blocked"
            ]
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "evidenceLevel": {
                  "enum": [
                    "design",
                    "fixture",
                    "local_execution",
                    "host_execution",
                    "external_verified"
                  ]
                }
              },
              "required": [
                "ref",
                "kind",
                "evidenceLevel"
              ]
            }
          },
          "criterionResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_run",
                    "blocked"
                  ]
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "status",
                "evidenceRefs",
                "scope"
              ]
            }
          },
          "missingCapabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "missing",
                    "denied",
                    "unverified"
                  ]
                },
                "impact": {
                  "type": "string"
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "required": [
                "slot",
                "state",
                "impact",
                "nextAction"
              ]
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "evidenceRef": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "action",
                "target",
                "retryable"
              ]
            }
          },
          "stopReason": {
            "type": "string"
          },
          "handoff": {
            "type": "object",
            "properties": {
              "nextOwner": {
                "type": "string"
              },
              "acceptedScope": {
                "type": "string"
              },
              "remaining": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiresDecision": {
                "type": "boolean"
              }
            },
            "required": [
              "nextOwner",
              "acceptedScope",
              "remaining",
              "requiresDecision"
            ]
          },
          "nativeRuntimeVerified": {
            "const": false,
            "description": "包静态合同或本地helper检查不会升级原生宿主加载；真实探测由调用方另外保存"
          }
        },
        "required": [
          "scope",
          "architecture",
          "migration",
          "status",
          "artifactRefs",
          "criterionResults",
          "missingCapabilities",
          "failures",
          "stopReason",
          "handoff",
          "nativeRuntimeVerified"
        ]
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "涉及医疗、法律、金融高影响结论或行动，停下交调用方按适用权限处理",
          "新的发布、生产变更、付费执行、敏感数据传输或持久访问由调用方确认；普通已授权可逆工作不重复确认",
          "任何明确拒绝均停止该目标，不切换工具、路由或Agent绕过"
        ]
      },
      "validation": [
        "tests/contract.test.mjs"
      ]
    }
  ]
}
