{
  "schemaVersion": 1,
  "id": "script-writer",
  "componentType": "agent",
  "componentVersion": "0.3.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "script-writer-write-script",
      "summary": "从已定选题与来源材料，结合具体读者和明确用户立场写成完整口播、分镜或正文；内部大纲服务成品，按渠道调整表达，保留开头、结尾和说法核对，不编造数据或亲历。",
      "useWhen": [
        "用户说「帮我写脚本」「口播稿」「分镜表」「这条视频怎么讲」",
        "用户说「帮我写小红书正文」「公众号文章」「视频文案」",
        "用户已有选题和角度（自己定的或来自 topic-planner），要变成能拍能发的稿子",
        "用户有草稿，想改得更口语、更紧凑，或改成另一个时长",
        "用户已有选题和来源文章、说明材料，想结合明确个人立场写成完整正文"
      ],
      "doNotUseWhen": [
        "用户还没定选题，只说「帮我写点东西」：改用 topic-planner",
        "用户只要标题、封面文字或封面版式：改用 headline-cover-optimizer",
        "用户要整套小红书图文发布包（含内页图）：改用 xiaohongshu-skill",
        "用户要逐字仿写、洗稿他人作品，或要求编造用户评价、销量、功效",
        "用户要剪辑、配音、上传、发布等执行动作：本 agent 只交稿子"
      ],
      "input": {
        "type": "object",
        "properties": {
          "topicAndAngle": {
            "type": "string",
            "description": "选题和切入角度，一句话"
          },
          "platform": {
            "type": "string",
            "description": "缺省按小红书图文假设并标注"
          },
          "format": {
            "enum": [
              "口播",
              "分镜",
              "图文正文",
              "公众号文章"
            ]
          },
          "lengthTarget": {
            "type": "string",
            "description": "时长（秒）或字数"
          },
          "persona": {
            "type": "string",
            "description": "口气、人设与用户明确表达的立场；未给口气时用朴素表达，未给立场时不替用户表态"
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "用户指定的来源文章、产品说明、草稿、证据或可拍素材；应保留出处、日期与适用限制"
          },
          "product": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "verifiedClaims": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "有来源的卖点"
              }
            }
          },
          "mustInclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mustAvoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "materialFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "用户明确提供或指定的来源文档、草稿、证据与素材清单文件"
          },
          "audience": {
            "type": "string",
            "description": "可选：具体读者、所在场景及其需要解决的问题；未提供时从已有材料作保守假设并标注"
          }
        },
        "required": [
          "topicAndAngle"
        ]
      },
      "output": {
        "type": "object",
        "deliveryFormat": "conceptual-human-delivery",
        "description": "面向用户的中文成品，保留现有字段；claimsCheck.source 区分来源事实与明确用户立场，作者推断或建议写入 assumptions，既有来源状态不表示已核验或用户亲历。",
        "properties": {
          "oneLiner": {
            "type": "string",
            "description": "给谁看，看完能做什么"
          },
          "hooks": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string"
            }
          },
          "content": {
            "description": "口播或分镜为分段表格（array）；图文正文与公众号文章为分段正文（string），不强制使用短视频骨架",
            "type": [
              "array",
              "string"
            ],
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string"
                },
                "visual": {
                  "type": "string"
                },
                "voiceover": {
                  "type": "string"
                },
                "subtitle": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "fullVoiceover": {
            "type": "string",
            "description": "仅口播或含口播的分镜提供全文、字数与时长估算；纯正文省略"
          },
          "ending": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "shotList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "仅需要拍摄时提供镜头和素材；纯正文无需拍摄时省略"
          },
          "claimsCheck": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "description": "材料出处及来源事实/用户立场的归属；不能把作者推断写成来源作者结论"
                },
                "status": {
                  "enum": [
                    "用户提供",
                    "用户亲历",
                    "用户观察",
                    "待核实",
                    "已删"
                  ]
                }
              },
              "required": [
                "claim",
                "status"
              ]
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "未确认前提及作者分析或写作建议；与来源事实、用户明确立场分开，不冒充用户观点"
          },
          "executionAuthorized": {
            "const": false
          }
        },
        "required": [
          "oneLiner",
          "hooks",
          "content",
          "ending",
          "claimsCheck"
        ]
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "稿子会给出医疗、法律、金融结论（用药、诊断、维权路径、收益承诺）：停下，说明原因并给改法，由用户决定",
          "商品功效、数据或用户评价没有可核实来源时，标为待核实或删除；不得改写为虚构个人经历或使用感受。",
          "用户要求逐字仿写他人作品或使用他人素材：拒绝并说明"
        ]
      },
      "validation": [
        "tests/contract.test.mjs"
      ]
    }
  ]
}
