{
  "schemaVersion": 1,
  "id": "design-system-designer",
  "componentType": "agent",
  "componentVersion": "0.3.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "design-system-designer-deliver",
      "summary": "把分散页面整理成一致的语义token、组件状态和可迁移的设计系统。 design system tokens component library",
      "useWhen": [
        "多个页面样式不统一，帮我整理设计系统。",
        "把Figma或Penpot规范转成组件规则。",
        "设计深色模式和多语言组件状态。"
      ],
      "doNotUseWhen": [
        "单页流程交interaction-designer。",
        "具体前端实现交frontend-engineer协作。",
        "完整品牌定位交brand-visual-designer。"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "surfaces": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "已有页面、组件、真实内容和用户任务"
          },
          "identity": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "品牌色、字体、语言、密度和平台"
          },
          "constraints": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "框架、兼容范围、可访问性目标和迁移节奏"
          },
          "designBinding": {
            "type": "object",
            "properties": {
              "designId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "designDigest": {
                "type": "string",
                "minLength": 1
              },
              "sliceId": {
                "type": "string",
                "minLength": 1
              },
              "contextDigest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "designId",
              "revision"
            ],
            "description": "由调用方提供的现行设计绑定；仅引用，不授予权限或自行认定当前版本。"
          },
          "designContext": {
            "type": "object",
            "description": "调用方投影的当前模块/决定/状态/接口/上游产物；只读任务上下文，不是权限或另一份PRD真源。",
            "properties": {
              "projectExperience": {
                "type": "object",
                "description": "当前 productDesign.projectExperience 的任务投影；引用项目独立专业规则与四层来源，不产生另一份设计或批准状态。字段及检查见 references/project-experience-api.md。",
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "layers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "level": {
                          "enum": [
                            "base",
                            "domain",
                            "brand",
                            "task"
                          ]
                        },
                        "source": {
                          "type": "object",
                          "properties": {
                            "ref": {
                              "type": "string",
                              "minLength": 1
                            },
                            "version": {
                              "type": "string",
                              "minLength": 1
                            },
                            "digest": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "ref",
                            "version"
                          ]
                        },
                        "rules": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "kind": {
                                "enum": [
                                  "visible_information",
                                  "representation",
                                  "recovery",
                                  "theme",
                                  "professional_judgment"
                                ]
                              },
                              "target": {
                                "type": "string",
                                "minLength": 1
                              },
                              "requirement": {
                                "type": "string",
                                "minLength": 1
                              },
                              "verification": {
                                "type": "string",
                                "minLength": 1
                              },
                              "value": {},
                              "invariant": {
                                "type": "boolean"
                              },
                              "overrides": {
                                "type": "string",
                                "minLength": 1
                              },
                              "taskIds": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "uniqueItems": true,
                                "minItems": 1
                              }
                            },
                            "required": [
                              "id",
                              "kind",
                              "target",
                              "requirement",
                              "verification"
                            ]
                          }
                        }
                      },
                      "required": [
                        "level",
                        "source",
                        "rules"
                      ]
                    }
                  },
                  "tasks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "actor": {
                          "type": "string",
                          "minLength": 1
                        },
                        "goal": {
                          "type": "string",
                          "minLength": 1
                        },
                        "successCondition": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "actor",
                        "goal",
                        "successCondition"
                      ]
                    }
                  }
                },
                "required": [
                  "schemaVersion",
                  "projectId",
                  "revision",
                  "layers",
                  "tasks"
                ]
              },
              "applicableExperienceTaskIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "调用方当前切片负责的projectExperience任务子集；省略时采用完整profile，共享规则保留。"
              }
            }
          },
          "projectFacts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "versions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "evidenceRefs"
                  ]
                }
              },
              "codeRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "versions",
              "codeRefs"
            ],
            "description": "本轮已核实的项目版本/代码入口/边界；未知版本写 null，不把网上最新版当安装版本。"
          }
        },
        "required": [
          "surfaces",
          "identity",
          "constraints"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "deliveryFormat": "conceptual-human-delivery",
        "properties": {
          "tokens": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "语义token与引用"
          },
          "components": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "组件行为与状态"
          },
          "examples": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "真实页面与多语言示例"
          },
          "migration": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "迁移和版本方案"
          },
          "facts": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "本次材料、版本、单位和假设"
          },
          "handoff": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "产物位置、未完成项和下一步"
          },
          "designBinding": {
            "type": "object",
            "properties": {
              "designId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "designDigest": {
                "type": "string",
                "minLength": 1
              },
              "sliceId": {
                "type": "string",
                "minLength": 1
              },
              "contextDigest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "designId",
              "revision"
            ],
            "description": "由调用方提供的现行设计绑定；仅引用，不授予权限或自行认定当前版本。"
          },
          "criterionResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_run",
                    "blocked"
                  ]
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "status",
                "evidenceRefs",
                "scope"
              ]
            }
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "evidenceLevel": {
                  "enum": [
                    "design",
                    "fixture",
                    "local_execution",
                    "host_execution",
                    "external_verified"
                  ]
                }
              },
              "required": [
                "ref",
                "kind",
                "evidenceLevel"
              ]
            }
          },
          "knowledgeUsage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "assetId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "appliedTo": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "assetId",
                "sourceRefs",
                "appliedTo",
                "verification",
                "limitations"
              ]
            },
            "description": "仅记录本轮实际装入或核实并使用的知识；PROVENANCE 清单不是本轮读取证据，不证明产物专业质量。"
          },
          "experienceApplication": {
            "type": "object",
            "description": "本轮提供 projectExperience 时，记录有效规则如何改变实际专业成果、当前页面状态及证据。规则ID回显不证明消费；helper只检查候选模型，实际体验仍需观察。",
            "properties": {
              "projectId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "enum": [
                  "research",
                  "design",
                  "implementation"
                ]
              },
              "ruleApplications": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ruleId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "specified",
                        "observed",
                        "not_run"
                      ]
                    },
                    "application": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifactRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "observationRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "ruleId",
                    "status",
                    "application"
                  ]
                }
              },
              "surfaceModels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "taskId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "information": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "visibility": {
                            "enum": [
                              "primary",
                              "visible",
                              "on_demand"
                            ]
                          },
                          "purpose": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id",
                          "visibility"
                        ]
                      }
                    },
                    "representations": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "recovery": {
                      "type": "object",
                      "properties": {
                        "preserve": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        },
                        "actions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      }
                    }
                  },
                  "required": [
                    "target",
                    "taskId"
                  ]
                }
              },
              "themeTokens": {
                "type": "object"
              }
            },
            "required": [
              "projectId",
              "revision",
              "scope",
              "ruleApplications"
            ]
          }
        },
        "required": [
          "tokens",
          "components",
          "examples",
          "migration",
          "facts",
          "handoff"
        ]
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "影响所有产品的品牌承诺或破坏性组件接口调整由对应负责人选择；原型和试点迁移可按已授权范围继续。"
        ]
      },
      "validation": [
        "tests/contract.test.mjs",
        "tests/tokens.test.mjs",
        "tests/project-experience.test.mjs"
      ]
    }
  ]
}
