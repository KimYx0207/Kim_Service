{
  "schemaVersion": 1,
  "id": "user-researcher",
  "componentType": "agent",
  "componentVersion": "0.2.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "user-researcher-deliver",
      "summary": "用户研究（user research / interview / usability evidence）：从目标人群与实际任务取证，交研究方案、观察记录、分歧与可验证需求。",
      "useWhen": [
        "用户说不好用，想知道到底卡在哪一步。",
        "需要设计访谈、观察或可用性测试。",
        "想把零散反馈转成有证据的产品需求。"
      ],
      "doNotUseWhen": [
        "不把虚构访谈当真人记录，不自动招募或联系用户；页面方案由interaction-designer等角色承接。",
        "要求自动发布、付款、修改生产系统或联系第三方时交调用方授权处理。",
        "要求把假设或资料形式当作专业认证、保证收益或最终验收时不适用。"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "要支持的产品决定、目标用户、任务和限制"
          },
          "materials": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "授权访谈、反馈、任务记录及招募来源；没有记录时明确是研究计划"
          },
          "constraints": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "可用时间、接触方式、同意范围与已有验收标准"
          },
          "designBinding": {
            "type": "object",
            "properties": {
              "designId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "designDigest": {
                "type": "string",
                "minLength": 1
              },
              "sliceId": {
                "type": "string",
                "minLength": 1
              },
              "contextDigest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "designId",
              "revision"
            ],
            "description": "由调用方提供的现行设计绑定；仅引用，不授予权限或自行认定当前版本。"
          },
          "designContext": {
            "type": "object",
            "description": "调用方投影的当前模块/决定/状态/接口/上游产物；只读任务上下文，不是权限或另一份PRD真源。",
            "properties": {
              "projectExperience": {
                "type": "object",
                "description": "当前 productDesign.projectExperience 的任务投影；引用项目独立专业规则与四层来源，不产生另一份设计或批准状态。字段及检查见 references/project-experience-api.md。",
                "properties": {
                  "schemaVersion": {
                    "const": 1
                  },
                  "projectId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "layers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "level": {
                          "enum": [
                            "base",
                            "domain",
                            "brand",
                            "task"
                          ]
                        },
                        "source": {
                          "type": "object",
                          "properties": {
                            "ref": {
                              "type": "string",
                              "minLength": 1
                            },
                            "version": {
                              "type": "string",
                              "minLength": 1
                            },
                            "digest": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "ref",
                            "version"
                          ]
                        },
                        "rules": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "kind": {
                                "enum": [
                                  "visible_information",
                                  "representation",
                                  "recovery",
                                  "theme",
                                  "professional_judgment"
                                ]
                              },
                              "target": {
                                "type": "string",
                                "minLength": 1
                              },
                              "requirement": {
                                "type": "string",
                                "minLength": 1
                              },
                              "verification": {
                                "type": "string",
                                "minLength": 1
                              },
                              "value": {},
                              "invariant": {
                                "type": "boolean"
                              },
                              "overrides": {
                                "type": "string",
                                "minLength": 1
                              },
                              "taskIds": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "uniqueItems": true,
                                "minItems": 1
                              }
                            },
                            "required": [
                              "id",
                              "kind",
                              "target",
                              "requirement",
                              "verification"
                            ]
                          }
                        }
                      },
                      "required": [
                        "level",
                        "source",
                        "rules"
                      ]
                    }
                  },
                  "tasks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "actor": {
                          "type": "string",
                          "minLength": 1
                        },
                        "goal": {
                          "type": "string",
                          "minLength": 1
                        },
                        "successCondition": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "actor",
                        "goal",
                        "successCondition"
                      ]
                    }
                  }
                },
                "required": [
                  "schemaVersion",
                  "projectId",
                  "revision",
                  "layers",
                  "tasks"
                ]
              },
              "applicableExperienceTaskIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "调用方当前切片负责的projectExperience任务子集；省略时采用完整profile，共享规则保留。"
              }
            }
          },
          "projectFacts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "versions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "evidenceRefs"
                  ]
                }
              },
              "codeRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "versions",
              "codeRefs"
            ],
            "description": "本轮已核实的项目版本/代码入口/边界；未知版本写 null，不把网上最新版当安装版本。"
          }
        },
        "required": [
          "question",
          "materials",
          "constraints"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "researchPlan": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "研究问题、抽样、任务、观察与分析方案"
          },
          "evidenceMatrix": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "原始行为、原话、情境、来源与解释的分离表"
          },
          "findings": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "问题、反例、影响范围与置信边界"
          },
          "decisionTests": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "需求候选与下一次可观察的验证任务"
          },
          "facts": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "当前输入、来源、期间单位及证据缺口"
          },
          "limitations": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "未执行、未观察、方法假设和外推边界"
          },
          "handoff": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "当前产物、规则结果、证据定位与待解决事项交调用方"
          },
          "designBinding": {
            "type": "object",
            "properties": {
              "designId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "designDigest": {
                "type": "string",
                "minLength": 1
              },
              "sliceId": {
                "type": "string",
                "minLength": 1
              },
              "contextDigest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "designId",
              "revision"
            ],
            "description": "由调用方提供的现行设计绑定；仅引用，不授予权限或自行认定当前版本。"
          },
          "criterionResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_run",
                    "blocked"
                  ]
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "status",
                "evidenceRefs",
                "scope"
              ]
            }
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "evidenceLevel": {
                  "enum": [
                    "design",
                    "fixture",
                    "local_execution",
                    "host_execution",
                    "external_verified"
                  ]
                }
              },
              "required": [
                "ref",
                "kind",
                "evidenceLevel"
              ]
            }
          },
          "knowledgeUsage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "assetId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "appliedTo": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "assetId",
                "sourceRefs",
                "appliedTo",
                "verification",
                "limitations"
              ]
            },
            "description": "仅记录本轮实际装入或核实并使用的知识；PROVENANCE 清单不是本轮读取证据，不证明产物专业质量。"
          },
          "experienceApplication": {
            "type": "object",
            "description": "本轮提供 projectExperience 时，记录有效规则如何改变实际专业成果、当前页面状态及证据。规则ID回显不证明消费；helper只检查候选模型，实际体验仍需观察。",
            "properties": {
              "projectId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "enum": [
                  "research",
                  "design",
                  "implementation"
                ]
              },
              "ruleApplications": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ruleId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "specified",
                        "observed",
                        "not_run"
                      ]
                    },
                    "application": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifactRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "observationRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "ruleId",
                    "status",
                    "application"
                  ]
                }
              },
              "surfaceModels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "taskId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "information": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "visibility": {
                            "enum": [
                              "primary",
                              "visible",
                              "on_demand"
                            ]
                          },
                          "purpose": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "id",
                          "visibility"
                        ]
                      }
                    },
                    "representations": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "recovery": {
                      "type": "object",
                      "properties": {
                        "preserve": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        },
                        "actions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      }
                    }
                  },
                  "required": [
                    "target",
                    "taskId"
                  ]
                }
              },
              "themeTokens": {
                "type": "object"
              }
            },
            "required": [
              "projectId",
              "revision",
              "scope",
              "ruleApplications"
            ]
          }
        },
        "required": [
          "researchPlan",
          "evidenceMatrix",
          "findings",
          "decisionTests",
          "facts",
          "limitations",
          "handoff"
        ],
        "deliveryFormat": "conceptual-human-delivery"
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "涉及录音、敏感材料、未成年人或招募报酬时由当前宿主核实授权与适用规则，研究分析可在已获准材料内继续。"
        ]
      },
      "validation": [
        "tests/contract.test.mjs",
        "tests/project-experience.test.mjs"
      ]
    }
  ]
}
