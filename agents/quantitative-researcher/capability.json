{
  "schemaVersion": 1,
  "id": "quantitative-researcher",
  "componentType": "agent",
  "componentVersion": "0.1.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "quantitative-researcher-deliver",
      "summary": "对明确数据和策略假设做可复现研究、成本敏感性与回测风险检查，不执行交易",
      "useWhen": [
        "检查策略回测方法和数据偏差",
        "核验收益、成本、回撤与样本外结果",
        "打包可复现研究与验收材料"
      ],
      "doNotUseWhen": [
        "代下单、转账或交易账户操作：交用户本人",
        "要求保证收益或捏造历史数据：拒绝",
        "一般经营数据复盘：使用 store-performance-analyst"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hypothesis": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "可证伪策略假设与评价指标"
          },
          "dataset": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "来源、时间区间、时区、频率、复权与可用时点"
          },
          "method": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "信号时点、执行时点、成本、样本切分与基准"
          },
          "runtimeBindings": {
            "type": "array",
            "description": "宿主对本次任务实际工具的绑定；需求不等于权限。未知/拒绝必须保留",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "available",
                    "missing",
                    "denied",
                    "unverified"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "authorizationRef": {
                  "type": "string"
                },
                "receiptRef": {
                  "type": "string"
                }
              },
              "required": [
                "slot",
                "state",
                "scope"
              ]
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "evidenceRequired": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "condition",
                "evidenceRequired"
              ]
            }
          },
          "handoffContext": {
            "type": "object",
            "description": "只给本角色相关材料与依赖产物；控制权保留调用方",
            "properties": {
              "taskId": {
                "type": "string"
              },
              "upstreamArtifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "permittedActions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resourceLeases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "string"
                    },
                    "ownerTaskId": {
                      "type": "string"
                    },
                    "leaseRef": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "resource",
                    "ownerTaskId",
                    "leaseRef"
                  ]
                }
              }
            },
            "required": [
              "taskId",
              "upstreamArtifacts",
              "permittedActions",
              "resourceLeases"
            ]
          }
        },
        "required": [
          "hypothesis",
          "dataset",
          "method",
          "acceptanceCriteria",
          "handoffContext"
        ]
      },
      "output": {
        "type": "object",
        "deliveryFormat": "conceptual-human-delivery",
        "description": "以下字段可用清晰正文交付；机器回执须另经helper验证。completed只限列明角色产物，不是最终用户结果或上线许可。",
        "properties": {
          "research": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "数据审计、方法说明与假设结论"
          },
          "results": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "净收益、回撤、成本敏感性、样本外结果和局限"
          },
          "reproducibility": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "数据/代码hash、固定参数、运行命令与回执"
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "needs_input",
              "blocked"
            ]
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "evidenceLevel": {
                  "enum": [
                    "design",
                    "fixture",
                    "local_execution",
                    "host_execution",
                    "external_verified"
                  ]
                }
              },
              "required": [
                "ref",
                "kind",
                "evidenceLevel"
              ]
            }
          },
          "criterionResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_run",
                    "blocked"
                  ]
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "status",
                "evidenceRefs",
                "scope"
              ]
            }
          },
          "missingCapabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "missing",
                    "denied",
                    "unverified"
                  ]
                },
                "impact": {
                  "type": "string"
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "required": [
                "slot",
                "state",
                "impact",
                "nextAction"
              ]
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "evidenceRef": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "action",
                "target",
                "retryable"
              ]
            }
          },
          "stopReason": {
            "type": "string"
          },
          "handoff": {
            "type": "object",
            "properties": {
              "nextOwner": {
                "type": "string"
              },
              "acceptedScope": {
                "type": "string"
              },
              "remaining": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiresDecision": {
                "type": "boolean"
              }
            },
            "required": [
              "nextOwner",
              "acceptedScope",
              "remaining",
              "requiresDecision"
            ]
          },
          "nativeRuntimeVerified": {
            "const": false,
            "description": "包静态合同或本地helper检查不会升级原生宿主加载；真实探测由调用方另外保存"
          }
        },
        "required": [
          "research",
          "results",
          "reproducibility",
          "status",
          "artifactRefs",
          "criterionResults",
          "missingCapabilities",
          "failures",
          "stopReason",
          "handoff",
          "nativeRuntimeVerified"
        ]
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "涉及医疗、法律、金融高影响结论或行动，停下交调用方按适用权限处理",
          "新的发布、生产变更、付费执行、敏感数据传输或持久访问由调用方确认；普通已授权可逆工作不重复确认",
          "任何明确拒绝均停止该目标，不切换工具、路由或Agent绕过"
        ]
      },
      "validation": [
        "tests/contract.test.mjs",
        "tests/calculation.test.mjs"
      ],
      "helperContract": "calculation-tool.json"
    }
  ]
}
