{
  "schemaVersion": 1,
  "id": "frontend-engineer",
  "componentType": "agent",
  "componentVersion": "0.1.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "frontend-engineer-deliver",
      "summary": "按已确认接口和交互规格实现可测试的前端变更并交付可回滚补丁",
      "useWhen": [
        "有明确前端缺陷和复现步骤",
        "按已定设计实现页面、编辑器或工作台",
        "需要前端状态、离线或同步冲突处理",
        "修复工作台执行状态，区分业务阶段与实时执行并展示来源缺失"
      ],
      "doNotUseWhen": [
        "未明确产品范围：交 product-architect",
        "更改服务认证和数据库：交 backend-data-engineer",
        "需要代替用户确认上线：交调用方"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "获准修改的代码范围和目标"
          },
          "interfaceContract": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "字段、错误码、认证和版本约定"
          },
          "interactionSpec": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "状态、响应式与无障碍要求"
          },
          "runtimeBindings": {
            "type": "array",
            "description": "宿主对本次任务实际工具的绑定；需求不等于权限。未知/拒绝必须保留",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "available",
                    "missing",
                    "denied",
                    "unverified"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "authorizationRef": {
                  "type": "string"
                },
                "receiptRef": {
                  "type": "string"
                }
              },
              "required": [
                "slot",
                "state",
                "scope"
              ]
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "evidenceRequired": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "condition",
                "evidenceRequired"
              ]
            }
          },
          "handoffContext": {
            "type": "object",
            "description": "只给本角色相关材料与依赖产物；控制权保留调用方",
            "properties": {
              "taskId": {
                "type": "string"
              },
              "upstreamArtifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "permittedActions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resourceLeases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "string"
                    },
                    "ownerTaskId": {
                      "type": "string"
                    },
                    "leaseRef": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "resource",
                    "ownerTaskId",
                    "leaseRef"
                  ]
                }
              }
            },
            "required": [
              "taskId",
              "upstreamArtifacts",
              "permittedActions",
              "resourceLeases"
            ]
          }
        },
        "required": [
          "scope",
          "interfaceContract",
          "interactionSpec",
          "acceptanceCriteria",
          "handoffContext"
        ]
      },
      "output": {
        "type": "object",
        "deliveryFormat": "conceptual-human-delivery",
        "description": "以下字段可用清晰正文交付；机器回执须另经helper验证。completed只限列明角色产物，不是最终用户结果或上线许可。",
        "properties": {
          "patch": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "限定文件补丁与版本/提交引用"
          },
          "behaviorEvidence": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "测试命令、回执、截图及目标提交绑定"
          },
          "handoffNotes": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "接口差异、回滚与剩余缺口"
          },
          "status": {
            "enum": [
              "completed",
              "partial",
              "needs_input",
              "blocked"
            ]
          },
          "artifactRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "evidenceLevel": {
                  "enum": [
                    "design",
                    "fixture",
                    "local_execution",
                    "host_execution",
                    "external_verified"
                  ]
                }
              },
              "required": [
                "ref",
                "kind",
                "evidenceLevel"
              ]
            }
          },
          "criterionResults": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "not_run",
                    "blocked"
                  ]
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "status",
                "evidenceRefs",
                "scope"
              ]
            }
          },
          "missingCapabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "missing",
                    "denied",
                    "unverified"
                  ]
                },
                "impact": {
                  "type": "string"
                },
                "nextAction": {
                  "type": "string"
                }
              },
              "required": [
                "slot",
                "state",
                "impact",
                "nextAction"
              ]
            }
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "evidenceRef": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "action",
                "target",
                "retryable"
              ]
            }
          },
          "stopReason": {
            "type": "string"
          },
          "handoff": {
            "type": "object",
            "properties": {
              "nextOwner": {
                "type": "string"
              },
              "acceptedScope": {
                "type": "string"
              },
              "remaining": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiresDecision": {
                "type": "boolean"
              }
            },
            "required": [
              "nextOwner",
              "acceptedScope",
              "remaining",
              "requiresDecision"
            ]
          },
          "nativeRuntimeVerified": {
            "const": false,
            "description": "包静态合同或本地helper检查不会升级原生宿主加载；真实探测由调用方另外保存"
          }
        },
        "required": [
          "patch",
          "behaviorEvidence",
          "handoffNotes",
          "status",
          "artifactRefs",
          "criterionResults",
          "missingCapabilities",
          "failures",
          "stopReason",
          "handoff",
          "nativeRuntimeVerified"
        ]
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "涉及医疗、法律、金融高影响结论或行动，停下交调用方按适用权限处理",
          "新的发布、生产变更、付费执行、敏感数据传输或持久访问由调用方确认；普通已授权可逆工作不重复确认",
          "任何明确拒绝均停止该目标，不切换工具、路由或Agent绕过"
        ]
      },
      "validation": [
        "tests/contract.test.mjs"
      ]
    }
  ]
}
