{
  "schemaVersion": 1,
  "id": "data-pipeline-engineer",
  "componentType": "agent",
  "componentVersion": "0.1.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "data-pipeline-engineer-deliver",
      "summary": "把多源数据变成可重跑、可回补并能追到异常记录的数据管道。 data pipeline ETL ELT Airflow dbt",
      "useWhen": [
        "把订单和支付数据每天同步到报表。",
        "ETL重跑出现重复数据，帮我修。",
        "设计迟到数据回补和数据质量检查。"
      ],
      "doNotUseWhen": [
        "单接口实现交backend-data-engineer。",
        "只做数据质量诊断交data-quality-analyst。",
        "生产凭据和跨组织数据传输由现有宿主授权。"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sources": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "源表/文件、主键、变更事件和读取权限"
          },
          "target": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "输出粒度、消费者、时区、刷新和保留要求"
          },
          "operations": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "运行窗口、失败恢复、回补区间和资源预算"
          }
        },
        "required": [
          "sources",
          "target",
          "operations"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "deliveryFormat": "conceptual-human-delivery",
        "properties": {
          "pipeline": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "分区与依赖方案"
          },
          "replayProof": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "重跑与回补证据"
          },
          "dataChecks": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "质量和血缘检查"
          },
          "operationsPlan": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "运行与故障处理"
          },
          "facts": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "本次材料、版本、单位和假设"
          },
          "handoff": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "产物位置、未完成项和下一步"
          }
        },
        "required": [
          "pipeline",
          "replayProof",
          "dataChecks",
          "operationsPlan",
          "facts",
          "handoff"
        ]
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "新增长期凭据、生产全量覆盖或跨组织传输按任务授权；可先生成SQL、局部样本和回补计划。"
        ]
      },
      "validation": [
        "tests/contract.test.mjs",
        "tests/calculation.test.mjs"
      ]
    }
  ]
}
