        "always"
      ],
      "sourceRefs": [
        "airflow-practices",
        "dbt-data-tests"
      ]
    },
    {
      "id": "data-pipeline-engineer-delivery",
      "path": "references/delivery-template.md",
      "appliesTo": [
        "always"
      ],
      "sourceRefs": [
        "airflow-practices",
        "dbt-data-tests"
      ]
    }
  ],
  "expertise": {
    "schemaVersion": 1,
    "domain": "数据管道工程师",
    "scope": [
      "把多源数据变成可重跑、可回补并能追到异常记录的数据管道。",
      "知识方法可独立使用；交付范围由当前任务确定。"
    ],
    "knowledgeAssetIds": [
      "data-pipeline-engineer-method",
      "data-pipeline-engineer-delivery"
    ],
    "diagnosticSequence": [
      {
        "id": "grain",
        "question": "目标一行是什么？",
        "evidenceRequired": [
          "业务键",
          "粒度"
        ],
        "whenMissing": "先定义粒度再聚合。"
      },
      {
        "id": "replay",
        "question": "第二次执行读取同一输入吗？",
        "evidenceRequired": [
          "批次/分区",
          "去重键"
        ],
        "whenMissing": "固定快照后验证。"
      },
      {
        "id": "completeness",
        "question": "零异常是正确还是没有数据？",
        "evidenceRequired": [
          "源数量",
          "预期分区"
        ],
        "whenMissing": "把完整性单列。"
      }
    ],
    "decisionRules": [
      {
        "id": "fixed-partition",
        "when": "可重跑任务",
        "action": "绑定输入分区或快照",
        "avoid": "重跑读取随时变化的latest"
      },
      {
        "id": "idempotent-write",
        "when": "数据重复投递",
        "action": "按业务键及版本处理并对账",
        "avoid": "只盲目追加"
      },
      {
        "id": "isolate-batch",
        "when": "单分区失败",
        "action": "保留成功分区、隔离失败批次",
        "avoid": "全部清空重建"
      }
    ],
    "contractGuidance": [
      {
        "capabilityId": "data-pipeline-engineer-deliver",
        "inputGuidance": [
          {
            "field": "sources",
            "interpretation": "源表/文件、主键、变更事件和读取权限",
            "onMissing": "先做源映射草案，未读的数据不假定存在。"
          },
          {
            "field": "target",
            "interpretation": "输出粒度、消费者、时区、刷新和保留要求",
            "onMissing": "先说明候选粒度，避免把明细和汇总混在同表。"
          },
          {
            "field": "operations",
            "interpretation": "运行窗口、失败恢复、回补区间和资源预算",
            "onMissing": "从单分区验证开始，扩大范围前观察成本。"
          }
        ],
        "outputChecks": [
          {
            "id": "data-pipeline-engineer-pipeline",
            "field": "pipeline",
            "criterion": "每任务固定输入窗口、输出粒度和提交边界，失败不暴露半成品。",
            "rejectWhen": "读取latest导致重跑输入变化，或失败后留半张生产结果。",
            "verificationMethod": "artifact_inspection",
            "evidenceRequired": [
              "DAG和分区规则",
              "提交方式"
            ],
            "blocking": true
          },
          {
            "id": "data-pipeline-engineer-replayproof",
            "field": "replayProof",
            "criterion": "同一分区重跑后主键集合、计数和金额不增加；迟到数据按规则回补。",
            "rejectWhen": "只比较行数却丢失/替换关键记录。",
            "verificationMethod": "behavior_probe",
            "evidenceRequired": [
              "两次输出主键及校验值",
              "回补差异"
            ],
            "blocking": true
          },
          {
            "id": "data-pipeline-engineer-datachecks",
            "field": "dataChecks",
            "criterion": "检查唯一/非空/关系及源到目标对账，零行另检预期完整性。",
            "rejectWhen": "空表因没有异常行就宣布数据正确。",
            "verificationMethod": "deterministic_recompute",
            "evidenceRequired": [
              "异常记录",
              "源目标数量金额"
            ],
            "blocking": true
          },
          {
            "id": "data-pipeline-engineer-operationsplan",
            "field": "operationsPlan",
            "criterion": "定位失败分区、重试上限、告警责任与保留成功分区。",
            "rejectWhen": "一处失败无差别全量重建。",
            "verificationMethod": "artifact_inspection",
            "evidenceRequired": [
              "操作手册",
              "恢复命令范围"
            ],
            "blocking": false
          },
          {
            "id": "data-pipeline-engineer-facts",
            "field": "facts",
            "criterion": "用于当前实质结论的关键事实与原始输入一致；来源未全时明确标注未知或假设，其他资料充分部分继续。",
            "rejectWhen": "把编造、推断或示例写成已核实的关键事实，使当前结论不可靠。",
            "verificationMethod": "source_check",
            "evidenceRequired": [
              "材料清单与假设"
            ],
            "blocking": true
          },
          {
            "id": "data-pipeline-engineer-handoff",
            "field": "handoff",
            "criterion": "给当前可用成果和受影响的待核项，独立部分可以继续。",
            "rejectWhen": "遗漏交付位置或下一步导致无法接手。",
            "verificationMethod": "artifact_inspection",
            "evidenceRequired": [
              "产物路径",
              "下一步"
            ],
            "blocking": false
          }
        ]
      }
    ],
    "reviewBoundary": {
      "humanReviewTriggers": [
        "新增长期凭据、生产全量覆盖或跨组织传输按任务授权；可先生成SQL、局部样本和回补计划。"
      ],
      "prohibitedClaims": [
        "示例是教学材料；真实完成情况以本次实际产物和检查为准。"
      ]
    },
    "evaluation": {
      "casesPath": "evals/professional-cases.json",
      "professionalEffect": "not_evaluated",
      "evidenceKind": "authored_examples"
    }
  }
}
