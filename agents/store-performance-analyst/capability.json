{
  "schemaVersion": 1,
  "id": "store-performance-analyst",
  "componentType": "agent",
  "componentVersion": "0.2.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "store-performance-analyst-assist",
      "summary": "店铺数据复盘：按SKU/渠道核口径，拆可比期间漏斗与收入变化，区分退款净收入、所列成本贡献和广告归因，交低成本核查及用户约束下的停止条件。",
      "useWhen": [
        "用户说「店铺有浏览但没订单怎么查」",
        "用户说「帮我复盘这周店铺数据」",
        "用户说「活动花了钱但效果不清楚」"
      ],
      "doNotUseWhen": [
        "商品文案交给 product-listing-writer。",
        "单个顾客的沟通交给 customer-service-writer。",
        "不登录后台、调广告预算或保证增长收益。"
      ],
      "input": {
        "type": "object",
        "properties": {
          "metrics": {
            "type": "string",
            "description": "原始数据：日期、曝光、访客、支付订单、收入、广告费及数据出处"
          },
          "comparison": {
            "type": "string",
            "description": "对比范围：可比的上一周期、商品或活动"
          },
          "definitions": {
            "type": [
              "string",
              "object"
            ],
            "description": "统计口径：去重方式、退款是否扣除、归因窗口和缺失值"
          },
          "table": {
            "description": "可选结构化period/sku/channel指标行；不替代必填metrics文字材料",
            "type": "array"
          },
          "decisionConstraints": {
            "description": "用户给出的观察天数、投入上限、继续与停止指标；未给时不自定业绩门槛",
            "type": "object"
          },
          "calculationReceipt": {
            "description": "宿主单独授权执行本包helper得到的真实stdout，核对tool/version/status及输入对应关系；不可由样例伪造",
            "type": "object"
          }
        },
        "required": [
          "metrics"
        ]
      },
      "output": {
        "type": "object",
        "deliveryFormat": "conceptual-human-delivery",
        "properties": {
          "dataQuality": {
            "type": "array",
            "description": "数据口径检查：检查周期、去重和订单口径，列缺失项及其限制的结论",
            "items": {
              "type": "string"
            }
          },
          "metricsTable": {
            "type": "array",
            "description": "指标与算式：列指标名称、原始数、计算式、单位和前后变化，区分百分比与百分点",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "array",
            "description": "可确认的变化：只列现有数据能确认的变化，说明样本量和可比性限制",
            "items": {
              "type": "string"
            }
          },
          "hypotheses": {
            "type": "array",
            "description": "待验证原因：将可能原因逐项标为待验证，并写出需要补充的证据",
            "items": {
              "type": "string"
            }
          },
          "experiments": {
            "type": "array",
            "description": "优先检查与验证：按影响和成本安排核查或小范围验证，写清观察指标与停止条件",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dataQuality",
          "metricsTable",
          "findings",
          "hypotheses",
          "experiments"
        ]
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "涉及医疗诊断、法律胜诉或金融投资收益等专业结论时停下，由具备资质的人员判断；涉及发布、对外发送或付款时须由用户另行授权。"
        ]
      },
      "validation": [
        "tests/contract.test.mjs",
        "tests/delivery.test.mjs"
      ],
      "helperContract": "calculation-tool.json",
      "deliveryContract": "delivery-tool.json"
    }
  ]
}
