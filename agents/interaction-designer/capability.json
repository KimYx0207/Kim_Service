            "type": "object",
            "properties": {
              "designId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "designDigest": {
                "type": "string",
                "minLength": 1
              },
              "sliceId": {
                "type": "string",
                "minLength": 1
              },
              "contextDigest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "designId",
              "revision"
            ],
            "description": "由调用方提供的现行设计绑定；仅引用，不授予权限或自行认定当前版本。"
          },
          "knowledgeUsage": {
            "type": "array",
