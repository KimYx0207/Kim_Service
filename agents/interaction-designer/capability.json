                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "implementationNotes": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "removalCandidates": {
                          "type": "array",
                          "items": {
                            "type": "object",
