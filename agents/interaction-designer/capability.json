            "description": "布局、token、响应式断点、键盘焦点、可读性与动效规格"
          },
          "reviewEvidence": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "逐状态截图/录屏对应的问题与待验项"
          },
          "experienceDesign": {
            "type": [
              "string",
              "object",
              "array"
            ],
