            "description": "本轮已核实的项目版本/代码入口/边界；未知版本写 null，不把网上最新版当安装版本。"
          }
        },
        "required": [
          "journey",
          "reference",
          "constraints",
          "acceptanceCriteria",
          "handoffContext"
        ]
      },
