{
  "schemaVersion": 1,
  "id": "interaction-designer",
  "componentType": "agent",
  "componentVersion": "0.3.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "interaction-designer-deliver",
      "summary": "为具体用户路径制作可实现的状态、视觉和动效规格，并用实际界面证据评审",
      "useWhen": [
        "多步骤流程有卡点，需要界面与交互改进",
        "需要响应式视觉、设计token和动效规格",
        "需要按截图或原型验证交互是否完整"
      ],
      "doNotUseWhen": [
        "需要改后端权限：交 backend-data-engineer",
        "纯代码实现：交 frontend-engineer",
        "只要封面文案：使用 headline-cover-optimizer"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "journey": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "目标用户、起点、动作与成功结果"
          },
          "reference": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "现界面截图或明确视觉参考及来源"
          },
          "constraints": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "平台、尺寸、无障碍与品牌边界"
          },
          "settledDecisions": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "调用方已定的需求选择与依据；会改变方向的选择未定时返回影响，不另开访谈"
          },
          "runtimeBindings": {
            "type": "array",
            "description": "宿主对本次任务实际工具的绑定；需求不等于权限。未知/拒绝必须保留",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "available",
                    "missing",
                    "denied",
                    "unverified"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "authorizationRef": {
                  "type": "string"
                },
                "receiptRef": {
                  "type": "string"
                }
              },
              "required": [
                "slot",
                "state",
                "scope"
              ]
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "condition": {
                  "type": "string"
                },
                "evidenceRequired": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "condition",
                "evidenceRequired"
              ]
            }
          },
          "handoffContext": {
            "type": "object",
            "description": "只给本角色相关材料与依赖产物；控制权保留调用方",
            "properties": {
              "taskId": {
                "type": "string"
              },
              "upstreamArtifacts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "permittedActions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resourceLeases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "string"
                    },
                    "ownerTaskId": {
                      "type": "string"
                    },
                    "leaseRef": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "resource",
                    "ownerTaskId",
                    "leaseRef"
                  ]
                }
              }
            },
            "required": [
              "taskId",
              "upstreamArtifacts",
              "permittedActions",
              "resourceLeases"
            ]
          },
          "designBinding": {
            "type": "object",
            "properties": {
              "designId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "designDigest": {
                "type": "string",
                "minLength": 1
              },
              "sliceId": {
                "type": "string",
                "minLength": 1
              },
              "contextDigest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "designId",
              "revision"
            ],
            "description": "由调用方提供的现行设计绑定；仅引用，不授予权限或自行认定当前版本。"
          },
          "designContext": {
            "type": "object",
            "description": "调用方投影的当前模块/决定/状态/接口/上游产物；只读任务上下文，不是权限或另一份PRD真源。"
          },
          "projectFacts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "versions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "evidenceRefs": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "evidenceRefs"
                  ]
                }
              },
              "codeRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "constraints": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "versions",
              "codeRefs"
