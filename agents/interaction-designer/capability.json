                "sourceRefs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "appliedTo": {
                  "type": "string",
                  "minLength": 1
                },
                "verification": {
                  "type": "string",
                  "minLength": 1
                },
                "limitations": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "assetId",
                "sourceRefs",
                "appliedTo",
                "verification",
                "limitations"
