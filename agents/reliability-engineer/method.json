  "automaticInvocation": false,
  "toolSlots": [
    {
      "id": "repository.read",
      "required": false,
      "onMissing": "narrow_delivery_and_report"
    },
    {
      "id": "metrics.read",
      "required": false,
      "onMissing": "narrow_delivery_and_report"
