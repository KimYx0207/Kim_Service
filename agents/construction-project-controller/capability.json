{
  "schemaVersion": 1,
  "id": "construction-project-controller",
  "componentType": "agent",
  "componentVersion": "0.1.0",
  "entrypoint": "AGENT.md",
  "capabilities": [
    {
      "id": "construction-project-controller-deliver",
      "summary": "把工程工作包、先后关系、完成量与成本连到同一基线，定位工期与预算偏差并形成可比较的纠偏方案。 construction project controls WBS critical path earned value change control",
      "useWhen": [
        "工程看着很忙但里程碑延期，需要核关键路径和实际完成量。",
        "支出超预算，需要分清进度提前、成本超支和范围变更。",
        "多个承包或设备交付相互依赖，需要比较赶工与重排方案。"
      ],
      "doNotUseWhen": [
        "施工安全方案、结构设计、签证支付、合同索赔和正式基线变更由有权限的工程责任人确认；本包交证据与候选分析。",
        "只要相邻领域通用建议、与本角色的具体工作对象无关时，交适合的现有角色。",
        "本任务要求直接变更账户、业务系统或发送材料时，由当前宿主按既有授权单独处理。"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "WBS、逻辑依赖、日历、里程碑、预算和批准版本"
          },
          "actuals": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "截至观察日实际完成量、验收、成本、承诺成本和现场记录"
          },
          "changes": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "变更请求、约束、资源与待决事项"
          }
        },
        "required": [
          "baseline",
          "actuals",
          "changes"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scheduleReview": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "依赖与工期分析"
          },
          "costPerformance": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "完成量与成本偏差"
          },
          "changeRegister": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "变更与基线差异表"
          },
          "recoveryOptions": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "纠偏备选与检查计划"
          },
          "facts": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "输入口径与证据"
          },
          "limitations": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "未核范围与适用边界"
          },
          "handoff": {
            "type": [
              "string",
              "object",
              "array"
            ],
            "description": "交付与下一步"
          }
        },
        "required": [
          "scheduleReview",
          "costPerformance",
          "changeRegister",
          "recoveryOptions",
          "facts",
          "limitations",
          "handoff"
        ],
        "deliveryFormat": "conceptual-human-delivery"
      },
      "permissions": [
        "filesystem:read-user-materials"
      ],
      "sideEffects": [],
      "humanGate": {
        "required": true,
        "when": [
          "施工安全方案、结构设计、签证支付、合同索赔和正式基线变更由有权限的工程责任人确认；本包交证据与候选分析。"
        ]
      },
      "validation": [
        "tests/contract.test.mjs"
      ]
    }
  ]
}
